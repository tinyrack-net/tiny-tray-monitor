// tray-monitor 리소스.
//
// - VERSIONINFO: 파일 속성(속성 > 자세히)에 보이는 버전. 숫자는 build.rs가 만든
//   version_defines.rc에서 온다. 여기에 손으로 적지 않는다.
// - 매니페스트: comctl32 v6(비주얼 스타일)와 PerMonitorV2 DPI. 코드가 아니라 여기서만 켠다.
// - ICON: 탐색기/시작 메뉴/작업 표시줄 아이콘. 가장 낮은 id를 셸이 고른다.
// - DIALOGEX(설정 창)는 G3에서 이 파일에 추가한다.
//
// 리소스 파일 경로는 crate 루트 기준이다(rc.exe의 작업 디렉터리가 crate 루트다).

#include <windows.h>
#include "version_defines.rc"

/* 설정 창. 컨트롤 id는 src/settings/dialog.rs의 상수와 같아야 한다(테스트로 대조한다).
 *
 * 글자는 비워 둔다. 런타임에 src/i18n.rs의 표에서 골라 WM_INITDIALOG에서 채운다.
 * 그래야 창을 닫지 않고 언어를 바꿀 수 있고, 레이아웃은 이 파일 하나로 유지된다. */
#define IDD_SETTINGS            101
#define IDC_CPU                 1001
#define IDC_MEMORY              1002
#define IDC_NETWORK_DOWN        1003
#define IDC_NETWORK_UP          1004
#define IDC_PREVIEW             1005
#define IDC_INTERVAL            1006
#define IDC_INTERVAL_EDIT       1007
#define IDC_INTERVAL_UNIT       1008
#define IDC_COLOR_METRIC        1009
#define IDC_COLOR_THEME         1010
#define IDC_VIRTUAL             1011
#define IDC_AUTOSTART           1012
#define IDC_STATUS              1013
#define IDC_VERSION             1014
#define IDC_GPU                 1015
#define IDC_GPU_VRAM            1016
#define IDC_RESET               1017
#define IDC_GROUP_READOUTS      1018
#define IDC_HINT_READOUTS       1019
#define IDC_GROUP_UPDATE        1020
#define IDC_HINT_UPDATE         1021
#define IDC_GROUP_APPEARANCE    1022
#define IDC_HINT_APPEARANCE     1023
#define IDC_GROUP_STARTUP       1024
#define IDC_HINT_STARTUP        1025
#define IDC_LABEL_INTERVAL      1026
#define IDC_LABEL_LANGUAGE      1027
#define IDC_LANGUAGE            1028
#define IDC_HINT_VIRTUAL        1029
#define IDC_HINT_LANGUAGE       1030

/* RT_MANIFEST = 24, CREATEPROCESS_MANIFEST_RESOURCE_ID = 1 */
1 24 "resources/app.manifest"

/* 앱 아이콘. 가장 낮은 id가 탐색기/시작 메뉴 아이콘으로 쓰인다. */
1 ICON "resources/app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, APP_VERSION_BUILD
 PRODUCTVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, APP_VERSION_BUILD
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "tinyrack"
            VALUE "FileDescription", "CPU, memory, network and GPU readouts in the Windows system tray"
            VALUE "FileVersion", APP_VERSION_STRING
            VALUE "InternalName", "tray-monitor"
            VALUE "LegalCopyright", "Copyright (c) 2026 winetree94"
            VALUE "OriginalFilename", "tray-monitor.exe"
            VALUE "ProductName", "TinyTrayManager"
            VALUE "ProductVersion", APP_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

/* 설정 창. 그룹 + 설명 한 줄 + 컨트롤로 나눈다. 모든 글자는 비워 두고 코드가 채운다. */
IDD_SETTINGS DIALOGEX 0, 0, 300, 288
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    /* 표시 항목 */
    GROUPBOX        "", IDC_GROUP_READOUTS, 7, 6, 286, 90
    LTEXT           "", IDC_HINT_READOUTS, 15, 17, 270, 9
    CONTROL         "", IDC_CPU, "Button", BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP, 17, 30, 84, 10
    CONTROL         "", IDC_MEMORY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 107, 30, 84, 10
    CONTROL         "", IDC_GPU, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 197, 30, 84, 10
    CONTROL         "", IDC_NETWORK_DOWN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 17, 42, 84, 10
    CONTROL         "", IDC_NETWORK_UP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 107, 42, 84, 10
    CONTROL         "", IDC_GPU_VRAM, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 197, 42, 84, 10
    /* 미리보기는 창이 뜨면 코드가 비트맵을 넣는다(SS_BITMAP). */
    CONTROL         "", IDC_PREVIEW, "Static", SS_BITMAP | SS_CENTERIMAGE | WS_BORDER | WS_GROUP, 17, 55, 266, 36
    /* 갱신 주기 */
    GROUPBOX        "", IDC_GROUP_UPDATE, 7, 102, 286, 36
    LTEXT           "", IDC_HINT_UPDATE, 15, 113, 270, 9
    LTEXT           "", IDC_LABEL_INTERVAL, 17, 125, 48, 9
    COMBOBOX        IDC_INTERVAL, 68, 123, 120, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    EDITTEXT        IDC_INTERVAL_EDIT, 192, 123, 42, 13, ES_NUMBER | ES_RIGHT | ES_AUTOHSCROLL
    LTEXT           "", IDC_INTERVAL_UNIT, 238, 125, 30, 9
    /* 모양 */
    GROUPBOX        "", IDC_GROUP_APPEARANCE, 7, 144, 286, 36
    LTEXT           "", IDC_HINT_APPEARANCE, 15, 155, 270, 9
    CONTROL         "", IDC_COLOR_METRIC, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP | WS_GROUP, 17, 167, 100, 10
    CONTROL         "", IDC_COLOR_THEME, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 124, 167, 110, 10
    /* 시작 및 언어 */
    GROUPBOX        "", IDC_GROUP_STARTUP, 7, 186, 286, 62
    LTEXT           "", IDC_HINT_STARTUP, 15, 197, 270, 9
    CONTROL         "", IDC_VIRTUAL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP | WS_GROUP, 17, 209, 130, 10
    LTEXT           "", IDC_HINT_VIRTUAL, 150, 210, 135, 9
    CONTROL         "", IDC_AUTOSTART, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 17, 222, 130, 10
    LTEXT           "", IDC_LABEL_LANGUAGE, 17, 235, 48, 9
    COMBOBOX        IDC_LANGUAGE, 68, 233, 120, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_HINT_LANGUAGE, 192, 235, 95, 9
    /* 상태줄·바닥 */
    LTEXT           "", IDC_STATUS, 10, 254, 200, 9
    RTEXT           "", IDC_VERSION, 232, 254, 60, 9
    PUSHBUTTON      "", IDC_RESET, 10, 266, 74, 14, WS_TABSTOP | WS_GROUP
    DEFPUSHBUTTON   "", IDCANCEL, 244, 266, 48, 14
END
